# macOS root gitconfig, stowed to ~/.gitconfig.
#
# On Datadog workspaces this file is not used: the platform owns ~/.gitconfig
# there and includes the user layer (users/rodrigo.fernandes/.gitconfig), which
# includes the same portable layer from ~/.dotfiles.
#
# What stays here is macOS-specific, or must remain reachable when the portable
# layer is not linked yet (a pull in ~/dotfiles goes live immediately, but a new
# stow target needs `stow -R`): signing defaults and hooks. Losing the portable
# layer therefore costs aliases and tuning, never signing or the Maat gate.

# Aliases and shared settings.
[include]
path = ~/.gitconfig.portable

[commit]
# https://docs.github.com/en/authentication/managing-commit-signature-verification/generating-a-new-gpg-key
gpgsign = true

[gpg]
format = ssh

[gpg "ssh"]
program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
# Stowed from git/.config/git/allowed_signers (public key material) so
# verify-commit works on current and rotated signatures alike.
allowedSignersFile = ~/.config/git/allowed_signers

# Default signing key: the 1Password "DataDog SSH Authentication & Signing
# keys" item (public material only) — the same key serves personal
# (rtfpessoa) and commercial repos on the Mac. Workspaces override it
# per-org via the wmux git-auth layers; ddoghq repos override it via the
# includeIf chain below (GitHub verifies ddoghq signatures only against
# keys registered on the ddoghq account).
[user]
signingKey = key::ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHsIVmGXH+CLtcN2o+q057GdyVitr/ICmNT+OAAEuGBN

# Sign tags like commits (SSH format via the agent).
[tag]
gpgsign = true


# Darwin filesystem semantics and the Maat global hooks. Workspaces keep the
# managed config's hooksPath, so this must not move to the portable layer.
[core]
ignorecase = true
# Make `git rebase` safer on macOS.
# More info: <http://www.git-tower.com/blog/make-git-rebase-safe-on-osx/>
trustctime = false
# Prevent showing files whose names contain non-ASCII symbols as unversioned.
# http://michael-kuehnel.de/git/2014/11/21/git-mac-osx-and-german-umlaute.html
precomposeunicode = false
hooksPath = ~/.local/share/code-factory/maat/hooks/global

[diff "bin"]
# Use `hexdump` to diff binary files (hexdump ships with macOS; workspace
# images do not guarantee bsdextrautils).
textconv = hexdump -v -C

[include]
path = ~/.gitconfig.extras

[include]
path = ~/.gitconfig.home

# ddoghq repos sign with the ddoghq signing key. The target is stowed
# from apps/ (macOS only): `~`-based paths keep this same gitconfig valid
# on Darwin and Linux, and on workspaces the absent include is silently
# skipped so the wmux git-auth layers own ddoghq signing there.
# Keep above ~/.gitconfig.machine so the machine layer stays last.
[includeIf "hasconfig:remote.*.url:git@github.com:ddoghq/**"]
path = ~/.gitconfig.ddoghq-signing
[includeIf "hasconfig:remote.*.url:git@ddoghq.github.com:ddoghq/**"]
path = ~/.gitconfig.ddoghq-signing
[includeIf "hasconfig:remote.*.url:https://github.com/ddoghq/**"]
path = ~/.gitconfig.ddoghq-signing
[includeIf "hasconfig:remote.*.url:ssh://git@github.com/ddoghq/**"]
path = ~/.gitconfig.ddoghq-signing
[includeIf "hasconfig:remote.*.url:ssh://git@ddoghq.github.com:ddoghq/**"]
path = ~/.gitconfig.ddoghq-signing
[includeIf "hasconfig:remote.*.url:git@github.com:ddoghq-sandbox/**"]
path = ~/.gitconfig.ddoghq-signing
[includeIf "hasconfig:remote.*.url:git@ddoghq.github.com:ddoghq-sandbox/**"]
path = ~/.gitconfig.ddoghq-signing
[includeIf "hasconfig:remote.*.url:https://github.com/ddoghq-sandbox/**"]
path = ~/.gitconfig.ddoghq-signing
[includeIf "hasconfig:remote.*.url:ssh://git@github.com/ddoghq-sandbox/**"]
path = ~/.gitconfig.ddoghq-signing
[includeIf "hasconfig:remote.*.url:ssh://git@ddoghq.github.com:ddoghq-sandbox/**"]
path = ~/.gitconfig.ddoghq-signing
[includeIf "hasconfig:remote.*.url:git@github.com:rodrigo-fernandes_ddog/**"]
path = ~/.gitconfig.ddoghq-signing
[includeIf "hasconfig:remote.*.url:git@ddoghq.github.com:rodrigo-fernandes_ddog/**"]
path = ~/.gitconfig.ddoghq-signing
[includeIf "hasconfig:remote.*.url:https://github.com/rodrigo-fernandes_ddog/**"]
path = ~/.gitconfig.ddoghq-signing
[includeIf "hasconfig:remote.*.url:ssh://git@github.com/rodrigo-fernandes_ddog/**"]
path = ~/.gitconfig.ddoghq-signing
[includeIf "hasconfig:remote.*.url:ssh://git@ddoghq.github.com:rodrigo-fernandes_ddog/**"]
path = ~/.gitconfig.ddoghq-signing

[include]
path = ~/.gitconfig.machine

