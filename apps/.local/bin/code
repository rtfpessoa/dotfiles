#!/usr/bin/env bash
#
# Stowed to ~/.local/bin/code. Delegates to the real VS Code CLI instead of
# re-implementing the Electron launch: MS's own launcher derives the app
# bundle from its own location, so a copy outside the .app bundle can never
# resolve it ("Unable to determine app path from symlink"). Delegation keeps
# this wrapper working across VS Code updates and platforms.

# when run in remote terminal, use the remote cli
if [ -n "$VSCODE_IPC_HOOK_CLI" ]; then
	REMOTE_CLI="$(which -a 'code' | grep /remote-cli/)"
	if [ -n "$REMOTE_CLI" ]; then
		"$REMOTE_CLI" "$@"
		exit $?
	fi
fi

# macOS: locate the .app bundle
for app in "/Applications/Visual Studio Code.app" \
	"$HOME/Applications/Visual Studio Code.app"; do
	bin="$app/Contents/Resources/app/bin/code"
	if [ -x "$bin" ]; then
		exec "$bin" "$@"
	fi
done

# fallback: another `code` on PATH (Linux, /usr/local/bin, homebrew)
self_path="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
IFS=$'\n'
for candidate in $(which -a code 2>/dev/null); do
	if [ "$candidate" != "$self_path" ] && [ -x "$candidate" ]; then
		exec "$candidate" "$@"
	fi
done

echo "code: Visual Studio Code CLI not found" >&2
exit 1
