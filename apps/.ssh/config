## BEGIN -- workspaces cli
## Generated content -- do not remove
# NOTE: This is at the top to ensure that other user or generated settings do
# not affect workspace connections.
# If you'd like to make changes that apply to all workspaces, see the comments
# in 00-common.conf alongside the included files below
Include ~/.ssh/workspaces/*
## END -- workspaces cli
Include ~/.orbstack/ssh/config
Include ~/.ssh/1Password/config
Include ~/.colima/ssh_config

# Git hosts must not share a multiplexed master: github.com and the
# ddoghq.github.com alias resolve to the same real host, so a shared
# control socket would fix whichever account authenticated first onto
# both aliases (ControlPath %C hashes the post-HostName host). This
# block sits above `Host *` below so first-match-wins makes it stick.
Host github.com gitlab.com ddoghq.github.com
  User git
  ControlMaster no
  ControlPath none

# Global defaults
Host *
  # Identity and key handling
  IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"

  # Prefer modern keys. Keep RSA only if you still need it.
  # IdentityFile "~/.ssh/id_ed25519"
  # IdentityFile "~/.ssh/id_rsa"

  # macOS specific options, safe to ignore elsewhere
  IgnoreUnknown AddKeysToAgent,UseKeychain
  AddKeysToAgent yes  # have the ssh command auto-add on first use
  UseKeychain yes     # make --apple-use-keychain and --apple-load-keychain the default

  # Host key hygiene
  HashKnownHosts yes
  StrictHostKeyChecking ask
  UserKnownHostsFile "~/.ssh/known_hosts"
  UpdateHostKeys yes

  # DNS SSHFP is nice when it is deployed correctly, but can also be flaky.
  # If you have not set up SSHFP with DNSSEC for your infra, consider turning this off.
  VerifyHostKeyDNS ask

  # Authentication posture
  PubkeyAuthentication yes
  PasswordAuthentication no
  KbdInteractiveAuthentication no
  ChallengeResponseAuthentication no
  PreferredAuthentications publickey

  # Safety defaults
  ForwardAgent no
  ForwardX11 no
  ForwardX11Trusted no
  VisualHostKey no

  # Connection quality
  ServerAliveInterval 60
  ServerAliveCountMax 3
  Compression yes

  # Multiplexing (more secure path than /tmp, avoids collisions, survives reboots sanely)
  ControlMaster auto
  ControlPersist 10m
  ControlPath ~/.ssh/cm/%C

  # Strong algorithm set (OpenSSH will ignore unknown entries gracefully)
  Ciphers chacha20-poly1305@openssh.com,aes256-gcm@openssh.com,aes128-gcm@openssh.com
  MACs hmac-sha2-512-etm@openssh.com,hmac-sha2-256-etm@openssh.com,umac-128-etm@openssh.com
  KexAlgorithms curve25519-sha256,curve25519-sha256@libssh.org
  HostKeyAlgorithms ssh-ed25519-cert-v01@openssh.com,ssh-ed25519

  # Optional: reduce chatty warnings for unknown options on older servers
  LogLevel INFO

# github.com must authenticate deterministically as the personal/Datadog
# account (rtfpessoa). The agent's key-enumeration order is not a
# contract — it also serves the ddoghq-managed-account key, which
# github.com accepts — so pin IdentitiesOnly to the keys that select
# rtfpessoa (the first-listed is agent-inert; the commercial key is the
# effective first offered). Replaces the git-config-tool ssh_config
# include, which pinned the same order.
Host github.com
  IdentitiesOnly yes
  IdentityFile ~/.ssh/keys/datadog-145635401.ghkey.pub
  IdentityFile ~/.ssh/keys/datadog-78634899.ghkey.pub
  IdentityFile ~/.ssh/keys/datadog-78809408.ghkey.pub

# ddoghq GitHub Enterprise-managed orgs: same real host, ddoghq account
# key. The 1Password agent serves it; the stowed .pub selects it via
# IdentitiesOnly so the personal key is never offered for ddoghq remotes.
# Replaces the git-config-tool ssh_config this file used to include.
Host ddoghq.github.com
  HostName github.com
  IdentitiesOnly yes
  IdentityFile ~/.ssh/keys/ddoghq.pub

# Localhost should not skip host checks
Host localhost 127.0.0.1 ::1
  VerifyHostKeyDNS no

# "legacy" hosts that require passwords or weaker algos
# Host old-box.example.com
#   PasswordAuthentication yes
#   KbdInteractiveAuthentication yes
#   PreferredAuthentications publickey,password
#   HostKeyAlgorithms +ssh-rsa
